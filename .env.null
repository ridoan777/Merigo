########################### SMTP ###########################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# AUTH_GUARD=sanctum

# -------- Laravel Scout --------
SCOUT_DRIVER=database


# -------- FIREBASE PUSH NOTIFICATION  --------
FIREBASE_CREDENTIALS=
FIREBASE_VAPID_KEY=
