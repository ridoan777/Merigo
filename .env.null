APP_NAME="Merigo"
APP_ENV=production
# APP_ENV=local,staging,production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC # Asia/Dhaka # America/New_York

# ---------- CORS SETUP ----------
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174,
SESSION_DOMAIN=127.0.0.1
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=false
# ---------- CORS SETUP ----------


# ---------- NGROK ----------
# APP_URL=
# SESSION_DOMAIN=.ngrok-free.dev
# SESSION_SECURE_COOKIE=false
# ---------- NGROK ----------

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- DATABASE ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# ---------- DATABASE ----------

SESSION_LIFETIME=1440 
SESSION_ENCRYPT=false
SESSION_PATH=/

SANCTUM_TOKEN_TTL=20160

FILESYSTEM_DISK=public
FILEPOND_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
########################### SMTP ###########################
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
